{
  "regions": [
    "dub1"
  ],
  "functions": {
    "app/api/invoices/**/route.ts": {
      "memory": 2048
    },
    "app/api/quotes/**/route.ts": {
      "memory": 2048
    },
    "app/api/social/projects/*/generate/route.ts": {
      "maxDuration": 300
    },
    "app/api/social/projects/*/slides/*/revise/route.ts": {
      "maxDuration": 300
    },
    "app/api/social/projects/*/export.zip/route.ts": {
      "memory": 2048,
      "maxDuration": 120
    },
    "app/api/social/projects/*/export.pdf/route.ts": {
      "memory": 2048,
      "maxDuration": 120
    },
    "app/api/social/projects/*/source.zip/route.ts": {
      "memory": 2048,
      "maxDuration": 120
    },
    "app/api/social/projects/*/slides/*/png/route.ts": {
      "memory": 2048,
      "maxDuration": 120
    },
    "app/api/mail/**/route.ts": {
      "maxDuration": 30
    },
    "app/api/cron/**/route.ts": {
      "maxDuration": 300
    },
    "app/api/beveiliging/backup/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/dagelijks",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/bestanden",
      "schedule": "30 4 */3 * *"
    }
  ]
}
