# Kopieer dit bestand naar ".env.local" en vul de waarden in vanuit je Supabase-project
# (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Let op: geheim, nooit met NEXT_PUBLIC_ prefixen, nooit naar de browser sturen.
SUPABASE_SERVICE_ROLE_KEY=

# Social media-module: Anthropic API-key voor het genereren van posts.
# Geheim; zet hem in Vercel onder Project Settings > Environment Variables.
ANTHROPIC_API_KEY=

# Mail-module (inbox op /mail en het dashboard) — Namecheap Private Email.
# Verplicht: MAIL_USER en MAIL_PASSWORD. De rest heeft standaardwaarden:
#   MAIL_IMAP_HOST=mail.privateemail.com  MAIL_IMAP_PORT=993 (SSL)
#   MAIL_SMTP_HOST=mail.privateemail.com  MAIL_SMTP_PORT=465 (SSL)
# Geheim (wachtwoord); zet ze in Vercel onder Project Settings > Environment Variables.
MAIL_USER=
MAIL_PASSWORD=
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
# Afzendernaam (standaard "Studio Levant") en optionele handtekening ("\n" = nieuwe regel).
MAIL_FROM_NAME=
MAIL_HANDTEKENING=
