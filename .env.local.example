# Kopieer dit bestand naar ".env.local" en vul de waarden in. Online (Vercel) zet je
# dezelfde variabelen onder Project Settings > Environment Variables
# (Production, Preview en Development). Zie README, "Omgevingsvariabelen".
# Zet hier NOOIT echte waarden in: dit voorbeeldbestand staat in git.

# --- Supabase (verplicht) — Supabase-dashboard > Project Settings > API ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Let op: geheim, nooit met NEXT_PUBLIC_ prefixen, nooit naar de browser sturen.
SUPABASE_SERVICE_ROLE_KEY=

# --- Publieke adres van de backoffice (aanbevolen) -----------------------------------
# Basis voor links in herstel- en uitnodigingsmails (nooit uit de Host-kop afgeleid).
# Bijvoorbeeld: https://backoffice.studio-levant.nl
NEXT_PUBLIC_SITE_URL=

# --- Social media-module — Anthropic API-key voor het genereren van posts --------
# Geheim. Zonder key werkt social, maar kan er niets gegenereerd worden.
ANTHROPIC_API_KEY=

# --- Mail per gebruiker (/account) -------------------------------------------------
# Geheim. Versleutelt de mailbox-wachtwoorden die teamleden zelf koppelen (AES-256-GCM).
# Maken met:  openssl rand -base64 32
#        of:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Zelfde waarde in .env.local en in Vercel (Production en Preview). Niet wijzigen: dan
# moet iedereen zijn mailbox opnieuw koppelen.
# Zonder deze sleutel kan niemand een eigen mailbox koppelen.
MAIL_ENCRYPTION_KEY=

# --- Mail-module (/mail, inbox-widget, badge in de rail) — Namecheap Private Email -
# Standaard-mailbox van de eigenaar (optioneel als iedereen via /account koppelt).
# Verplicht voor mail: MAIL_USER (volledig adres) en MAIL_PASSWORD (geheim).
# De rest heeft standaardwaarden en mag leeg blijven:
#   MAIL_IMAP_HOST=mail.privateemail.com  MAIL_IMAP_PORT=993 (SSL)
#   MAIL_SMTP_HOST=mail.privateemail.com  MAIL_SMTP_PORT=465 (SSL)
# Zonder MAIL_USER/MAIL_PASSWORD toont de app een nette "nog niet gekoppeld"-uitleg.
MAIL_USER=
MAIL_PASSWORD=
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
# Afzendernaam (standaard "Studio Levant") en optionele handtekening ("\n" = nieuwe regel).
MAIL_FROM_NAME=
MAIL_HANDTEKENING=

# --- Google Drive (module Bestanden) ------------------------------------------------
# OAuth-client (type "Web application") uit Google Cloud Console, zie README "Google Drive".
# Redirect-URI's: http://localhost:3000/api/drive/callback en
# https://<jouw domein>/api/drive/callback. Het secret is geheim.
# Zonder deze twee toont Bestanden welke variabelen ontbreken.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optioneel: eigen sleutel (32 bytes, base64; openssl rand -base64 32) voor het versleutelde
# refresh token. Leeg = MAIL_ENCRYPTION_KEY. Wijzigen = Drive opnieuw koppelen.
DRIVE_ENCRYPTION_KEY=

# --- Alleen lokaal (optioneel) ----------------------------------------------------
# Pad naar een lokale Chrome/Chromium voor social-exports (PNG/PDF) tijdens `npm run dev`;
# zonder waarde zoekt de app zelf naar Chrome, Chromium, Edge of Brave.
# Op Vercel niet nodig (daar wordt @sparticuz/chromium gebruikt).
CHROME_PATH=

# --- Beveiliging (migratie 0026) ------------------------------------------------
# Tweestapsverificatie (2FA) verplicht voor alle teamleden. Standaard AAN (leeg laten).
# Alleen "uit" zet het verplicht instellen tijdelijk uit (noodgeval); wie al een apparaat
# heeft, vult nog steeds zijn code in. Zie docs/BEVEILIGING.md.
MFA_AFDWINGEN=
# Optioneel: eigen geheim voor de sessiecookie (12 uur inactief / 14 dagen max). Leeg = afgeleid
# van SUPABASE_SERVICE_ROLE_KEY. Genereren: openssl rand -base64 32
SESSIE_GEHEIM=
# Optioneel: peper voor de hashes van IP-adressen en e-mailadressen in audit-log en
# pogingenlimiet. Leeg = afgeleid van SUPABASE_SERVICE_ROLE_KEY.
AUDIT_PEPPER=
# Alleen "0" zet de overgangsmodus van vóór migratie 0021 terug (iedereen met een account is
# lid als team_members ontbreekt). Leeg laten: ontbreekt de tabel, dan een storing (veilig).
TEAM_VEREIST=
