# Kopieer dit bestand naar ".env.local" en vul de waarden in. Online (Vercel) zet je
# dezelfde variabelen onder Project Settings > Environment Variables
# (Production, Preview en Development). Zie README, "Omgevingsvariabelen".
# Zet hier NOOIT echte waarden in: dit voorbeeldbestand staat in git.

# --- Supabase (verplicht) — Supabase-dashboard > Project Settings > API ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Let op: geheim, nooit met NEXT_PUBLIC_ prefixen, nooit naar de browser sturen.
SUPABASE_SERVICE_ROLE_KEY=

# --- Publieke adres van de backoffice (aanbevolen) -----------------------------------
# Basis voor links in herstel- en uitnodigingsmails (nooit uit de Host-kop afgeleid).
# Bijvoorbeeld: https://backoffice.studio-levant.nl
NEXT_PUBLIC_SITE_URL=

# --- Social media-module — Anthropic API-key voor het genereren van posts --------
# Geheim. Zonder key werkt social, maar kan er niets gegenereerd worden.
ANTHROPIC_API_KEY=

# --- Mail-module (/mail, inbox-widget, badge in de rail) — Namecheap Private Email -
# Verplicht voor mail: MAIL_USER (volledig adres) en MAIL_PASSWORD (geheim).
# De rest heeft standaardwaarden en mag leeg blijven:
#   MAIL_IMAP_HOST=mail.privateemail.com  MAIL_IMAP_PORT=993 (SSL)
#   MAIL_SMTP_HOST=mail.privateemail.com  MAIL_SMTP_PORT=465 (SSL)
# Zonder MAIL_USER/MAIL_PASSWORD toont de app een nette "nog niet gekoppeld"-uitleg.
MAIL_USER=
MAIL_PASSWORD=
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
# Afzendernaam (standaard "Studio Levant") en optionele handtekening ("\n" = nieuwe regel).
MAIL_FROM_NAME=
MAIL_HANDTEKENING=

# --- Alleen lokaal (optioneel) ----------------------------------------------------
# Pad naar een lokale Chrome/Chromium voor social-exports (PNG/PDF) tijdens `npm run dev`;
# zonder waarde zoekt de app zelf naar Chrome, Chromium, Edge of Brave.
# Op Vercel niet nodig (daar wordt @sparticuz/chromium gebruikt).
CHROME_PATH=
