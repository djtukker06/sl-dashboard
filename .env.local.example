# Kopieer dit bestand naar ".env.local" en vul de waarden in vanuit je Supabase-project
# (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Let op: geheim, nooit met NEXT_PUBLIC_ prefixen, nooit naar de browser sturen.
SUPABASE_SERVICE_ROLE_KEY=

# Social media-module: Anthropic API-key voor het genereren van posts.
# Geheim; zet hem in Vercel onder Project Settings > Environment Variables.
ANTHROPIC_API_KEY=
